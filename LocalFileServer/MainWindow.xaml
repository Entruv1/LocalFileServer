<Window x:Class="LocalFileServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地文件服务器"
        Icon="pack://application:,,,/app_icon.ico"
        Width="560" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与状态 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="本地文件服务器" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border x:Name="StatusBadge" Background="#E8F4F0" CornerRadius="14" Padding="12,4" DockPanel.Dock="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#0F6E56" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="已停止" Foreground="#0F6E56" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- 访问地址 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="访问地址" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtUrl" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="#185FA5" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="在浏览器打开" Click="OpenBrowser_Click" Padding="10,6" Margin="10,0,0,0"
                        Style="{StaticResource {x:Type Button}}"/>
            </Grid>
        </Border>

        <!-- 参数卡片 -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="监听端口" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <Button Content="应用" Click="ApplyPort_Click" DockPanel.Dock="Right" Padding="8,3"
                                FontSize="11" BorderBrush="#D1D5DB"/>
                    </DockPanel>
                    <TextBox x:Name="TxtPort" Text="8848" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"
                             BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="本机 IP" FontSize="12" Foreground="#6B7280"/>
                    <ComboBox x:Name="CmbIP" FontSize="13" Margin="0,8,0,0" Padding="4"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="访问口令" FontSize="12" Foreground="#6B7280"/>
                    <PasswordBox x:Name="TxtToken" FontSize="13" Margin="0,8,0,0" Padding="4"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 共享目录 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <Button Content="选择共享目录" Click="ChooseDir_Click" Padding="10,6" DockPanel.Dock="Right" Margin="10,0,0,0"/>
            <TextBlock Text="共享目录" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="TxtRoot" TextChanged="TxtRoot_TextChanged" FontSize="13"
                     VerticalContentAlignment="Center" Padding="6,5" Background="White"/>
        </DockPanel>

        <!-- 控制按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,2,0,14">
            <Button x:Name="BtnStart" Content="启动服务" Click="Start_Click" Padding="18,8" FontSize="14"
                    Background="#185FA5" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnStop" Content="停止服务" Click="Stop_Click" Padding="18,8" FontSize="14"
                    Margin="10,0,0,0" IsEnabled="False" BorderBrush="#D1D5DB"/>
            <Button Content="在共享目录打开" Click="OpenFolder_Click" Padding="12,8" Margin="10,0,0,0"
                    BorderBrush="#D1D5DB"/>
        </StackPanel>

        <!-- 日志 -->
        <Border Grid.Row="6" Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="12" Foreground="#6B7280" Margin="2,0,0,6"/>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#F8F9FA" BorderThickness="0" FontFamily="Consolas,monospace" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="7" Text="路由器端抓取：wget -O /root/脚本名 http://IP:端口/脚本名   然后 sh /root/脚本名"
                   FontSize="12" Foreground="#6B7280" Margin="2,10,2,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
